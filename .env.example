# Local PostgreSQL 16 — trust auth, no password, localhost only.
# Copy to `.env` and adjust if your cluster differs. Never commit `.env`.
DATABASE_URL="postgresql://postgres@localhost:5433/shop_dev?schema=public"

# Used by migrate-deploy checks and integration tests; never by the app at runtime.
TEST_DATABASE_URL="postgresql://postgres@localhost:5433/shop_test?schema=public"

# Auth.js signs the JWT session cookie with this value. Generate a fresh one:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Never commit a real value; `.env` is gitignored.
AUTH_SECRET="replace-with-a-generated-secret"

# Simulated payment webhook. Any non-empty value works locally; requests are
# signed with HMAC-SHA256 of `<unix timestamp>.<raw body>` in the
# `x-payments-signature: t=...,v1=...` header. There is no Stripe key.
PAYMENTS_WEBHOOK_SECRET="replace-with-a-local-demo-secret"

# Optional shared secret for POST /api/internal/sweep-reservations. When set,
# callers must send it as `x-sweeper-secret`; production requires it.
SWEEPER_SECRET=""
