# Environment contract for the storefront.
#
# Copy to `.env` and fill the values locally. `.env` is gitignored; this file is
# the committed list of every variable the application or its release step
# reads. No value here is a secret: empty means "unconfigured" and the code
# fails closed or uses its development fallback. Never commit a real value.

# --- Database ---------------------------------------------------------------
# PostgreSQL 16. The app, Prisma migrations and the seed all read this name.
# Production: the Neon pooled connection string, pasted in the Render dashboard
# (never committed). Local: the native cluster on port 5433.
DATABASE_URL="postgresql://postgres@localhost:5433/shop_dev?schema=public"

# Vitest and Playwright only; the running app never reads it.
TEST_DATABASE_URL="postgresql://postgres@localhost:5433/shop_test?schema=public"

# --- Auth.js ----------------------------------------------------------------
# Signs the JWT session cookie. Generate a fresh value per environment:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# The placeholder below is deliberately not a usable secret.
AUTH_SECRET="replace-with-a-generated-secret"

# Optional Auth.js alias. Either name works; AUTH_SECRET wins when both are set.
NEXTAUTH_SECRET=""

# --- Stripe -----------------------------------------------------------------
# Server-side key. Never exposed to the browser and never a Docker build arg.
STRIPE_SECRET_KEY=""

# Inlined into the client bundle by `next build`. It must be present when the
# image is built, not only when the container runs. Public by design.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Signing secret for POST /api/webhooks/payments. Empty makes the route answer
# 503 to every delivery (fail closed). Paste the endpoint secret from the
# Stripe dashboard in W1-c.
STRIPE_WEBHOOK_SECRET=""

# Alias accepted by src/lib/stripe.ts; Render's blueprint sets this name.
# STRIPE_WEBHOOK_SECRET takes precedence when both are present.
PAYMENTS_WEBHOOK_SECRET=""

# Test-only SDK override for the local Stripe mock. Ignored when
# NODE_ENV=production. Leave empty in production.
STRIPE_API_HOST=""

# --- Reservation sweeper ----------------------------------------------------
# Required in production. Callers send it as `x-sweeper-secret`; the scheduled
# GitHub Actions workflow reads the same value from its repository secret.
SWEEPER_SECRET=""

# --- Host runtime -----------------------------------------------------------
# Set by the platform in production; documented here because the standalone
# server and the container healthcheck read them.
NODE_ENV="development"
PORT="3000"
HOSTNAME="0.0.0.0"

# --- Repository tooling (never read by the app) -----------------------------
# Playwright's dev server and Stripe mock ports.
E2E_PORT="3100"
MOCK_STRIPE_PORT="12111"
# Proof/load scripts talk to an already running server.
CAPTURE_BASE_URL="http://127.0.0.1:3000"
BASE_URL="http://127.0.0.1:3200"
LOAD_USERS="250"
# CI marker used by Playwright's reporter and retry settings.
CI=""
