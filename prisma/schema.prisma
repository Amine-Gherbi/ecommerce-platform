// P2 data model — 12 tables.
//
// Eight of them carry the correctness claims (User, Order, Variant, OrderItem,
// StockReservation, Cart, CartItem, WebhookEvent). Product, Category, Coupon and
// the single Auth.js adapter table (Account) complete the model.
//
// Rules encoded here:
//   * money is integer cents everywhere; no floats, no client-trusted price
//   * OrderItem snapshots sku / name / unit price — order history never changes
//   * Variant is archived, never deleted (order history depends on it)
//   * one order per (userId, idempotencyKey); the unique index is the arbiter
//   * stripePaymentIntentId is unique and is the webhook -> order link
//   * no Session table: Auth.js uses JWT sessions with Credentials
//
// Constraints Prisma cannot express are added in the initial migration:
//   * CHECK (stock >= 0) on Variant
//   * CHECK (percentOff between 0 and 100) on Coupon
//   * GIN index over to_tsvector(name || ' ' || description) on Product

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  FULFILLED
  CANCELLED
  REFUND_REQUIRED
  REFUNDED
}

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  // Nullable: GitHub accounts with private email return null.
  email         String?   @unique
  // Nullable: OAuth-only users have no password.
  passwordHash  String?
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())

  accounts Account[]
  carts    Cart[]
  orders   Order[]
}

// The only Auth.js adapter table in the model: sessions are stateless JWTs.
model Account {
  id                String  @id @default(uuid(7)) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Category {
  id   String @id @default(uuid(7)) @db.Uuid
  slug String @unique
  name String

  products Product[]
}

model Product {
  id          String    @id @default(uuid(7)) @db.Uuid
  // Public route identifier; product routes never expose the id.
  slug        String    @unique
  name        String
  description String
  categoryId  String    @db.Uuid
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants Variant[]

  // Listing: WHERE categoryId = $1 AND archivedAt IS NULL ORDER BY createdAt DESC.
  // archivedAt must NOT sit between the equality and the sort key: IS NULL is not
  // an equality for pathkey purposes, so (categoryId, archivedAt, createdAt) cannot
  // supply the ordering. (categoryId, createdAt) can, with archivedAt as a filter.
  @@index([categoryId, createdAt])
}

model Variant {
  id         String    @id @default(uuid(7)) @db.Uuid
  productId  String    @db.Uuid
  sku        String    @unique
  name       String
  priceCents Int
  // Reservation is UPDATE ... WHERE stock >= qty; the CHECK below is the backstop.
  stock      Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@index([productId])
}

model Cart {
  // Supplied by the cart_id cookie (plan §4); existing carts are looked up by id,
  // so this is the one id that is not generated by the ORM.
  id        String   @id @db.Uuid
  userId    String?  @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @db.Uuid
  status         OrderStatus @default(PENDING)
  // sha256(cart.id + ':' + cartVersion); the unique index makes double-submit safe.
  idempotencyKey String
  subtotalCents  Int
  discountCents  Int         @default(0)
  totalCents     Int
  currency       String      @db.Char(3) @default("usd")
  // The webhook does not know our order id; this column is the link.
  stripePaymentIntentId String? @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  reservations StockReservation[]

  @@unique([userId, idempotencyKey])
  // Reconciliation: pending orders older than N minutes.
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @db.Uuid
  // SetNull, not Cascade: archiving a variant must not touch order history.
  variantId      String? @db.Uuid
  // Snapshots: history is immutable even if the product changes or is archived.
  sku            String
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model StockReservation {
  id         String    @id @default(uuid(7)) @db.Uuid
  orderId    String    @db.Uuid
  variantId  String    @db.Uuid
  qty        Int
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  // Sweeper: releasedAt IS NULL AND expiresAt < now().
  @@index([expiresAt])
  @@index([variantId])
}

model Coupon {
  id         String    @id @default(uuid(7)) @db.Uuid
  code       String    @unique
  // Percent only for the single seeded coupon; money stays in cents on Order.
  percentOff Int
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

model WebhookEvent {
  // Stripe's event id is the idempotency key; insert-on-conflict is the replay guard.
  stripeEventId String   @id
  type          String
  payload       Json
  processedAt   DateTime @default(now())

  @@index([type, processedAt])
}
